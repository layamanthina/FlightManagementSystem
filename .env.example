# ============================================================
# Flight Management System - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Database credentials (shared across all services)
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT configuration (must be identical in user-service and api-gateway)
JWT_SECRET=flightmanagementsystemsecurejwtsecretkey123456789
JWT_EXPIRATION_MS=86400000
